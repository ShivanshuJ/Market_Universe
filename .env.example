# Copy to .env and fill in. .env is git-ignored. Never commit keys.
CRUSTDATA_KEY=
# Optional: lets the brief be written by a model (numbers are still checked against computed facts).
ANTHROPIC_API_KEY=
XRAY_MODEL=claude-sonnet-5-5

# Credit guard: a run stops pulling data once it has spent this many credits.
XRAY_BUDGET=300
# Cap on people pulled per company (about 0.23 credits per person with experience).
XRAY_MAX_PEOPLE=800
# Look-back window in days for "recent joiners".
XRAY_WINDOW_DAYS=365

# 1 = answer from saved fixtures (no network, no credits). Use as a demo fallback.
XRAY_OFFLINE=0
# Demo of crash/resume: set to a step name (people, jobs, ...) and the process exits right after it.
XRAY_CRASH_AFTER=
